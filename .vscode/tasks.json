{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "EC: Build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/ExtendedConversations.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
          "label": "EC: Copy Assets",
          "type": "shell",
          "command": "./copy-assets.sh",
          "options": {
            "cwd": "${workspaceFolder}"
          }
        },
        {
          "label": "EC: Build + Deploy",
          "dependsOn": ["EC: Build", "EC: Copy Assets"],
          "dependsOrder": "sequence",
          "problemMatcher": []
        }
    ]
}
